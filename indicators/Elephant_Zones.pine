//@version=6
// =============================================================================
//  ELEPHANT ZONES  🐘  —  top / bottom supply-demand zones (swing + HTF levels)
// -----------------------------------------------------------------------------
//  The chart-side half of the Elephant tool shown in the Upsurge club course
//  video: long horizontal GREY ZONES drawn from a top or a bottom and extended
//  to the right, with a dotted line at the edge price reacts to.
//
//  TWO SOURCES, one look:
//
//   A) SWING PIVOTS  (the original behaviour)
//        top    -> RESISTANCE zone : [ pivot high - depth , pivot high ]
//        bottom -> SUPPORT zone    : [ pivot low , pivot low + depth ]
//        depth  = zoneDepthAtr x ATR14          (default 0.35 ATR)
//
//   B) HIGHER-TIMEFRAME LEVELS  (new)
//        PDH / PDL  -> previous day high / low      (symmetric band, 0.25 ATR)
//        PWH / PWL  -> previous week high / low
//        PDC        -> previous day close (optional)
//        All read with request.security(..., lookahead_off) so they never repaint.
//
//  Zones are created only on CLOSED bars, stop extending the moment price closes
//  through them (0.15 ATR buffer), and the oldest ones are recycled so the chart
//  never becomes a grey wall.
//
//  Note about the price-scale tags in the video screenshot: those little grey
//  boxes on the right axis are TradingView *drawing* labels (the presenter drew
//  rectangles by hand).  Pine drawings cannot write to the price scale, so this
//  indicator prints the range as a right-edge label instead.
//
//  Companion files:
//    indicators/Elephant_Indicator.pine        (pane: eye / tusk / trunk)
//    indicators/Elephant_Signals_Overlay.pine  (price: BUY/SELL + trade plan)
// =============================================================================
indicator("Elephant Zones 🐘 [Tops & Bottoms]", shorttitle="ELEPHANT ZN", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=500)

// -----------------------------------------------------------------------------
// 1. INPUTS
// -----------------------------------------------------------------------------
G_Z = "1. Swing zone engine (tops & bottoms)"
G_H = "2. Higher-timeframe levels (PDH / PDL / PWH / PWL)"
G_M = "3. Mitigation & recycling"
G_V = "4. Colours, labels & alerts"

bool  usePivots  = input.bool(true, "Draw swing-pivot zones", group=G_Z)
int   pivotLen   = input.int(5, "Pivot strength (bars each side)", minval=2, maxval=50, group=G_Z)
float zoneAtr    = input.float(0.35, "Swing zone depth (x ATR14)", minval=0.05, maxval=3.0, step=0.05, group=G_Z)
bool  useBody    = input.bool(false, "Anchor swing zones to the candle body (close) instead of the wick", group=G_Z)
bool  showTopBot = input.bool(false, "Print TOP / BOTTOM labels at the pivot bar", group=G_Z)

bool  usePDH     = input.bool(true, "Previous day high (PDH)", group=G_H)
bool  usePDL     = input.bool(true, "Previous day low (PDL)", group=G_H)
bool  usePDC     = input.bool(false, "Previous day close (PDC)", group=G_H)
bool  usePWH     = input.bool(true, "Previous week high (PWH)", group=G_H)
bool  usePWL     = input.bool(true, "Previous week low (PWL)", group=G_H)
float htfZoneAtr = input.float(0.25, "HTF zone depth (x ATR14, total band)", minval=0.05, maxval=3.0, step=0.05, group=G_H)
bool  htfLabels  = input.bool(true, "Name the HTF zones (PDH / PDL / PWH / PWL)", group=G_H)

int   atrLen     = input.int(14, "ATR length", minval=2, maxval=100, group=G_M)
int   extendBars = input.int(10, "Extend the live zone this many bars to the right", minval=0, maxval=200, group=G_M)
string minGapMode= input.string("ATR", "Ignore a new swing zone if it is closer than", options=["Off", "ATR", "Percent"], group=G_M)
float minGapAtr  = input.float(0.60, "…this many ATR from the opposite zone", minval=0.0, maxval=5.0, step=0.05, group=G_M)
float minGapPct  = input.float(0.15, "…or this % of price", minval=0.0, maxval=2.0, step=0.01, group=G_M)
float brkBufAtr  = input.float(0.15, "Break buffer beyond the zone (x ATR)", minval=0.0, maxval=2.0, step=0.05, group=G_M)
bool  removeBroken = input.bool(false, "Delete a zone after price breaks it", group=G_M)
bool  fadeBroken = input.bool(true, "Fade (grey-out) broken zones instead of deleting", group=G_M)
int   maxZones   = input.int(20, "Maximum zones kept on the chart", minval=2, maxval=60, group=G_M)

string theme     = input.string("Grey (video style)", "Colour theme", options=["Grey (video style)", "Red / Green", "Blue / Orange", "Mono dark"], group=G_V)
bool  showLevel  = input.bool(true, "Dotted level line at the reaction edge", group=G_V)
bool  showLabels = input.bool(true, "Show zone labels (range / prices)", group=G_V)
bool  showTouchHint = input.bool(false, "Mark zone taps with a small ●", group=G_V)

color fillRes   = theme == "Red / Green" ? color.new(color.red, 88)   : theme == "Blue / Orange" ? color.new(color.orange, 88)  : color.new(color.gray, 86)
color fillSup   = theme == "Red / Green" ? color.new(color.green, 88) : theme == "Blue / Orange" ? color.new(color.blue, 88)    : color.new(color.gray, 88)
color bordRes   = theme == "Red / Green" ? color.new(color.red, 40)   : theme == "Blue / Orange" ? color.new(color.orange, 40)  : theme == "Mono dark" ? color.new(color.silver, 40) : color.new(color.gray, 45)
color bordSup   = theme == "Red / Green" ? color.new(color.green, 40) : theme == "Blue / Orange" ? color.new(color.blue, 40)    : theme == "Mono dark" ? color.new(color.silver, 40) : color.new(color.gray, 45)
color bordHtf   = theme == "Mono dark" ? color.new(color.silver, 20) : color.new(color.gray, 15)
color txtCol    = theme == "Mono dark" ? color.new(color.silver, 0) : color.new(color.gray, 5)

// -----------------------------------------------------------------------------
// 2. CORE
// -----------------------------------------------------------------------------
float atrRaw = ta.atr(atrLen)
float atrV   = nz(atrRaw, ta.tr) > 0 ? nz(atrRaw, ta.tr) : syminfo.mintick
float mintick = nz(syminfo.mintick, 0.0001)
float depth  = math.max(zoneAtr * atrV, mintick * 2)
float htfDep = math.max(htfZoneAtr * atrV, mintick * 2)
float brkBuf = brkBufAtr * atrV

float pivotHi = ta.pivothigh(pivotLen, pivotLen)
float pivotLo = ta.pivotlow(pivotLen, pivotLen)
int   pivotBar = bar_index - pivotLen

// body anchors read one pivot-length back
float bodyHi = math.max(open[pivotLen], close[pivotLen])
float bodyLo = math.min(open[pivotLen], close[pivotLen])
float anchorHi = useBody ? bodyHi : pivotHi
float anchorLo = useBody ? bodyLo : pivotLo

// higher-timeframe levels (non-repainting: previous completed bar of that TF)
float pdHigh = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_off)
float pdLow  = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_off)
float pdClose= request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)
float pwHigh = request.security(syminfo.tickerid, "W", high[1],  lookahead=barmerge.lookahead_off)
float pwLow  = request.security(syminfo.tickerid, "W", low[1],   lookahead=barmerge.lookahead_off)

// -----------------------------------------------------------------------------
// 3. STORAGE (parallel arrays — one entry per live zone)
// -----------------------------------------------------------------------------
var array<box>   zBox    = array.new_box()
var array<line>  zLine   = array.new_line()
var array<label> zLabel  = array.new_label()
var array<float> zTop    = array.new_float()
var array<float> zBot    = array.new_float()
var array<int>   zStart  = array.new_int()
var array<bool>  zIsRes  = array.new_bool()
var array<bool>  zBroken = array.new_bool()
var array<bool>  zHtf    = array.new_bool()

// -----------------------------------------------------------------------------
// 4. HELPERS
// -----------------------------------------------------------------------------
f_gapOk(bool isRes, float top, float bot) =>
    bool ok = true
    if array.size(zTop) > 0 and minGapMode != "Off"
        for i = 0 to array.size(zTop) - 1
            if array.get(zIsRes, i) != isRes and not array.get(zHtf, i)
                float a = array.get(zTop, i)
                float b = array.get(zBot, i)
                float gap = isRes ? math.max(b - top, bot - a) : math.max(a - bot, top - b)
                float need = minGapMode == "ATR" ? minGapAtr * atrV : close * minGapPct / 100.0
                if gap < need
                    ok := false
    ok

f_addZone(float zHi, float zLo, int startBar, bool isRes, string tag, bool isHtf) =>
    box b = box.new(startBar, zHi, bar_index + extendBars, zLo, xloc=xloc.bar_index, bgcolor=isRes ? fillRes : fillSup, border_color=isHtf ? bordHtf : (isRes ? bordRes : bordSup), border_width=isHtf ? 2 : 1, text=showLabels ? (tag != "" ? tag + " " + str.tostring((zHi + zLo) / 2.0, format.mintick) : str.tostring(zHi, format.mintick) + " – " + str.tostring(zLo, format.mintick)) : "", text_size=size.tiny, text_color=txtCol, text_halign=text.align_right, text_valign=text.align_center)
    line l = na
    if showLevel
        l := line.new(startBar, isRes ? zLo : zHi, bar_index + extendBars, isRes ? zLo : zHi, xloc=xloc.bar_index, color=isHtf ? bordHtf : (isRes ? bordRes : bordSup), style=line.style_dotted, width=isHtf ? 2 : 1)
    label lb = na
    if showLabels
        string ltxt = tag != "" ? tag + " " + str.tostring((zHi + zLo) / 2.0, format.mintick) : str.tostring(zLo, format.mintick) + " – " + str.tostring(zHi, format.mintick)
        lb := label.new(bar_index + extendBars, isRes ? zLo : zHi, ltxt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=txtCol, size=size.tiny)
    array.push(zBox, b)
    array.push(zLine, l)
    array.push(zLabel, lb)
    array.push(zTop, zHi)
    array.push(zBot, zLo)
    array.push(zStart, startBar)
    array.push(zIsRes, isRes)
    array.push(zBroken, false)
    array.push(zHtf, isHtf)

// -----------------------------------------------------------------------------
// 5. CREATE — swing pivots
// -----------------------------------------------------------------------------
bool newRes = false
bool newSup = false

if usePivots and barstate.isconfirmed and not na(pivotHi) and not na(atrRaw) and f_gapOk(true, anchorHi, anchorHi - depth)
    f_addZone(anchorHi, anchorHi - depth, pivotBar, true, "", false)
    newRes := true
    if showTopBot
        label.new(pivotBar, anchorHi + 0.4 * atrV, "TOP", style=label.style_label_down, color=color.new(color.red, 60), textcolor=color.white, size=size.tiny)

if usePivots and barstate.isconfirmed and not na(pivotLo) and not na(atrRaw) and f_gapOk(false, anchorLo + depth, anchorLo)
    f_addZone(anchorLo + depth, anchorLo, pivotBar, false, "", false)
    newSup := true
    if showTopBot
        label.new(pivotBar, anchorLo - 0.4 * atrV, "BOTTOM", style=label.style_label_up, color=color.new(color.green, 60), textcolor=color.white, size=size.tiny)

// -----------------------------------------------------------------------------
// 6. CREATE — higher-timeframe levels (only when the level actually changes)
// -----------------------------------------------------------------------------
// one zone per new daily bar / weekly bar — never per-bar, never repainting
bool newDayBar  = timeframe.isintraday and timeframe.change("D")
bool newWeekBar = not timeframe.isdaily and timeframe.change("W")

if barstate.isconfirmed and usePDH and newDayBar and not na(pdHigh)
    f_addZone(pdHigh + htfDep / 2.0, pdHigh - htfDep / 2.0, bar_index, true, htfLabels ? "PDH" : "", true)

if barstate.isconfirmed and usePDL and newDayBar and not na(pdLow)
    f_addZone(pdLow + htfDep / 2.0, pdLow - htfDep / 2.0, bar_index, false, htfLabels ? "PDL" : "", true)

if barstate.isconfirmed and usePDC and newDayBar and not na(pdClose)
    f_addZone(pdClose + htfDep / 2.0, pdClose - htfDep / 2.0, bar_index, close < pdClose, htfLabels ? "PDC" : "", true)

if barstate.isconfirmed and usePWH and newWeekBar and not na(pwHigh)
    f_addZone(pwHigh + htfDep / 2.0, pwHigh - htfDep / 2.0, bar_index, true, htfLabels ? "PWH" : "", true)

if barstate.isconfirmed and usePWL and newWeekBar and not na(pwLow)
    f_addZone(pwLow + htfDep / 2.0, pwLow - htfDep / 2.0, bar_index, false, htfLabels ? "PWL" : "", true)

// -----------------------------------------------------------------------------
// 7. EXTEND / MITIGATE / RECYCLE
// -----------------------------------------------------------------------------
bool tapRes = false
bool tapSup = false
bool justBrokeRes = false
bool justBrokeSup = false

if array.size(zBox) > 0
    for i = array.size(zBox) - 1 to 0
        bool  isRes  = array.get(zIsRes, i)
        bool  broken = array.get(zBroken, i)
        bool  isHtf  = array.get(zHtf, i)
        float top    = array.get(zTop, i)
        float bot    = array.get(zBot, i)
        box   b      = array.get(zBox, i)
        line  l      = array.get(zLine, i)
        label lb     = array.get(zLabel, i)
        bool tapped = isRes ? (high >= bot and low <= top) : (low <= top and high >= bot)
        if tapped and not broken
            if isRes
                tapRes := true
            else
                tapSup := true
            if showTouchHint and barstate.isconfirmed
                label.new(bar_index, isRes ? top : bot, "●", style=isRes ? label.style_label_down : label.style_label_up, color=color.new(color.black, 100), textcolor=color.new(color.gray, 0), size=size.tiny)
        if barstate.isconfirmed and not broken
            bool broke = isRes ? close > top + brkBuf : close < bot - brkBuf
            if broke
                array.set(zBroken, i, true)
                box.set_right(b, bar_index)
                if not na(l)
                    line.set_x2(l, bar_index)
                if not na(lb)
                    label.set_x(lb, bar_index)
                if isRes
                    justBrokeRes := true
                else
                    justBrokeSup := true
                if fadeBroken
                    box.set_bgcolor(b, color.new(color.gray, 94))
                    box.set_border_color(b, color.new(color.gray, 75))
                    if not na(l)
                        line.set_color(l, color.new(color.gray, 80))
            else
                box.set_right(b, bar_index + extendBars)
                if not na(l)
                    line.set_x2(l, bar_index + extendBars)
                if not na(lb)
                    label.set_x(lb, bar_index + extendBars)

    while array.size(zBox) > maxZones
        box.delete(array.shift(zBox))
        line lrm = array.shift(zLine)
        label lbrm = array.shift(zLabel)
        if not na(lrm)
            line.delete(lrm)
        if not na(lbrm)
            label.delete(lbrm)
        array.shift(zTop)
        array.shift(zBot)
        array.shift(zStart)
        array.shift(zIsRes)
        array.shift(zBroken)
        array.shift(zHtf)

if removeBroken and array.size(zBox) > 0
    for i = array.size(zBox) - 1 to 0
        if array.get(zBroken, i)
            box bd = array.remove(zBox, i)
            line ld = array.get(zLine, i)
            label lbd = array.get(zLabel, i)
            array.remove(zLine, i)
            array.remove(zLabel, i)
            array.remove(zTop, i)
            array.remove(zBot, i)
            array.remove(zStart, i)
            array.remove(zIsRes, i)
            array.remove(zBroken, i)
            array.remove(zHtf, i)
            box.delete(bd)
            if not na(ld)
                line.delete(ld)
            if not na(lbd)
                label.delete(lbd)

// -----------------------------------------------------------------------------
// 8. HUD — nearest live zones + HTF levels
// -----------------------------------------------------------------------------
var table hud = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 82), border_width=1, border_color=color.new(color.gray, 70), frame_width=1, frame_color=color.new(color.gray, 55))
float nearRes = na
float nearSup = na
int liveCount = 0
if array.size(zTop) > 0
    for i = 0 to array.size(zTop) - 1
        if not array.get(zBroken, i)
            liveCount := liveCount + 1
            if array.get(zIsRes, i)
                float cand = array.get(zBot, i)
                if na(nearRes) or cand < nearRes
                    nearRes := cand
            else
                float cand2 = array.get(zTop, i)
                if na(nearSup) or cand2 > nearSup
                    nearSup := cand2

if barstate.islast
    table.cell(hud, 0, 0, "🐘 ELEPHANT ZONES", text_color=color.new(color.yellow, 0), text_size=size.small)
    table.cell(hud, 1, 0, str.tostring(liveCount) + " live", text_color=color.new(color.silver, 0), text_size=size.small)
    table.cell(hud, 0, 1, "Nearest resistance", text_color=color.new(color.silver, 0), text_size=size.tiny)
    table.cell(hud, 1, 1, na(nearRes) ? "—" : str.tostring(nearRes, format.mintick) + " (" + str.tostring((nearRes - close) / atrV, "#.0") + " ATR)", text_color=nearRes > close ? color.new(color.red, 0) : color.new(color.white, 0), text_size=size.tiny)
    table.cell(hud, 0, 2, "Nearest support", text_color=color.new(color.silver, 0), text_size=size.tiny)
    table.cell(hud, 1, 2, na(nearSup) ? "—" : str.tostring(nearSup, format.mintick) + " (" + str.tostring((close - nearSup) / atrV, "#.0") + " ATR)", text_color=nearSup < close ? color.new(color.green, 0) : color.new(color.white, 0), text_size=size.tiny)
    table.cell(hud, 0, 3, "PDH / PDL", text_color=color.new(color.silver, 0), text_size=size.tiny)
    table.cell(hud, 1, 3, (na(pdHigh) ? "—" : str.tostring(pdHigh, format.mintick)) + " / " + (na(pdLow) ? "—" : str.tostring(pdLow, format.mintick)), text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(hud, 0, 4, "PWH / PWL", text_color=color.new(color.silver, 0), text_size=size.tiny)
    table.cell(hud, 1, 4, (na(pwHigh) ? "—" : str.tostring(pwHigh, format.mintick)) + " / " + (na(pwLow) ? "—" : str.tostring(pwLow, format.mintick)), text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(hud, 0, 5, "Swing depth / HTF depth", text_color=color.new(color.silver, 0), text_size=size.tiny)
    table.cell(hud, 1, 5, str.tostring(depth, format.mintick) + " / " + str.tostring(htfDep, format.mintick), text_color=color.new(color.white, 0), text_size=size.tiny)

// -----------------------------------------------------------------------------
// 9. ALERTS
// -----------------------------------------------------------------------------
alertcondition(newRes, "Elephant new RESISTANCE zone", "🐘 New resistance zone on {{ticker}} {{interval}} — a top has been confirmed.")
alertcondition(newSup, "Elephant new SUPPORT zone", "🐘 New support zone on {{ticker}} {{interval}} — a bottom has been confirmed.")
alertcondition(tapRes and barstate.isconfirmed, "Elephant resistance tapped", "🐘 Price is tapping a resistance zone on {{ticker}} {{interval}} at {{close}}.")
alertcondition(tapSup and barstate.isconfirmed, "Elephant support tapped", "🐘 Price is tapping a support zone on {{ticker}} {{interval}} at {{close}}.")
alertcondition(justBrokeRes and barstate.isconfirmed, "Elephant resistance BROKEN", "🐘 Resistance zone broken on {{ticker}} {{interval}} at {{close}} — tops are being taken out.")
alertcondition(justBrokeSup and barstate.isconfirmed, "Elephant support BROKEN", "🐘 Support zone broken on {{ticker}} {{interval}} at {{close}} — bottoms are being taken out.")

if tapRes and barstate.isconfirmed
    alert("🐘 Resistance tapped | " + syminfo.ticker + " " + timeframe.period + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if tapSup and barstate.isconfirmed
    alert("🐘 Support tapped | " + syminfo.ticker + " " + timeframe.period + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
