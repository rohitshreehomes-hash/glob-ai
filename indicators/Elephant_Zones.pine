//@version=6
// =============================================================================
//  ELEPHANT ZONES  🐘  —  automatic top / bottom supply-demand zones
// -----------------------------------------------------------------------------
//  This is the chart-side half of the Elephant tool shown in the Upsurge.club
//  course video (ETH 15m screenshot): long horizontal GREY ZONES drawn from a
//  confirmed top or bottom and extended to the right, with a dotted level line
//  at the edge price reacts to.
//
//  A top   -> RESISTANCE zone  :  [ swing high - depth , swing high ]
//  A bottom-> SUPPORT zone     :  [ swing low        , swing low + depth ]
//  depth   = zoneDepthAtr x ATR14   (default 0.35 ATR)
//
//  Zones are created only from CONFIRMED pivots (pivotLen bars each side), so
//  they never repaint, and they stop extending the moment price closes through
//  them (mitigated).  Old zones are recycled so the chart stays readable.
//
//  Note about the price-scale tags in the video screenshot: those little grey
//  boxes on the right axis are TradingView *drawing* labels (the presenter drew
//  rectangles by hand).  Pine drawings cannot write to the price scale, so this
//  indicator prints the zone range as a right-edge label instead — turn
//  "Show zone labels" on/off to taste.
//
//  Works on indices, futures, options and crypto, 1m .. 1D.
//  Companion files:
//    indicators/Elephant_Indicator.pine        (pane: eye / tusk / trunk)
//    indicators/Elephant_Signals_Overlay.pine  (price: BUY/SELL + trade plan)
// =============================================================================
indicator("Elephant Zones 🐘 [Tops & Bottoms]", shorttitle="ELEPHANT ZN", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=500)

// -----------------------------------------------------------------------------
// 1. INPUTS
// -----------------------------------------------------------------------------
G_Z = "1. Zone engine (tops & bottoms)"
G_M = "2. Mitigation & recycling"
G_V = "3. Colours, labels & alerts"

int   pivotLen   = input.int(5, "Pivot strength (bars each side)", minval=2, maxval=50, group=G_Z)
float zoneAtr    = input.float(0.35, "Zone depth (x ATR14)", minval=0.05, maxval=3.0, step=0.05, group=G_Z)
int   atrLen     = input.int(14, "ATR length", minval=2, maxval=100, group=G_Z)
bool  useBody    = input.bool(false, "Anchor zones to the candle body (close) instead of the wick", group=G_Z)
int   extendBars = input.int(10, "Extend the live zone this many bars to the right", minval=0, maxval=200, group=G_Z)
string minGapMode= input.string("ATR", "Ignore a new zone if it is closer than", options=["Off", "ATR", "Percent"], group=G_Z)
float minGapAtr  = input.float(0.60, "…this many ATR from the opposite zone", minval=0.0, maxval=5.0, step=0.05, group=G_Z)
float minGapPct  = input.float(0.15, "…or this % of price", minval=0.0, maxval=2.0, step=0.01, group=G_Z)
bool  showTopBot = input.bool(false, "Print TOP / BOTTOM labels at the pivot bar", group=G_Z)

float brkBufAtr  = input.float(0.15, "Break buffer beyond the zone (x ATR)", minval=0.0, maxval=2.0, step=0.05, group=G_M)
bool  removeBroken = input.bool(false, "Delete a zone after price breaks it", group=G_M)
bool  fadeBroken = input.bool(true, "Fade (grey-out) broken zones instead of deleting", group=G_M)
int   maxZones   = input.int(16, "Maximum zones kept on the chart", minval=2, maxval=60, group=G_M)

string theme     = input.string("Grey (video style)", "Colour theme", options=["Grey (video style)", "Red / Green", "Blue / Orange", "Mono dark"], group=G_V)
bool  showLevel  = input.bool(true, "Dotted level line at the reaction edge", group=G_V)
bool  showLabels = input.bool(true, "Show zone labels (range / prices)", group=G_V)
int   labelSize  = input.int(9, "Label text size", minval=6, maxval=20, group=G_V)
bool  showTouchHint = input.bool(false, "Mark zone taps with a small ●", group=G_V)

color fillRes   = theme == "Red / Green" ? color.new(color.red, 88)   : theme == "Blue / Orange" ? color.new(color.orange, 88)  : theme == "Mono dark" ? color.new(color.gray, 88) : color.new(color.gray, 86)
color fillSup   = theme == "Red / Green" ? color.new(color.green, 88) : theme == "Blue / Orange" ? color.new(color.blue, 88)    : theme == "Mono dark" ? color.new(color.gray, 88) : color.new(color.gray, 88)
color bordRes   = theme == "Red / Green" ? color.new(color.red, 40)   : theme == "Blue / Orange" ? color.new(color.orange, 40)  : theme == "Mono dark" ? color.new(color.silver, 40) : color.new(color.gray, 45)
color bordSup   = theme == "Red / Green" ? color.new(color.green, 40) : theme == "Blue / Orange" ? color.new(color.blue, 40)    : theme == "Mono dark" ? color.new(color.silver, 40) : color.new(color.gray, 45)
color txtCol    = theme == "Mono dark" ? color.new(color.silver, 0) : color.new(color.gray, 5)

// -----------------------------------------------------------------------------
// 2. CORE
// -----------------------------------------------------------------------------
float atrRaw = ta.atr(atrLen)
float atrV   = nz(atrRaw, ta.tr) > 0 ? nz(atrRaw, ta.tr) : syminfo.mintick
float mintick = nz(syminfo.mintick, 0.0001)
float depth  = math.max(zoneAtr * atrV, mintick * 2)
float brkBuf = brkBufAtr * atrV

float pivotHi = ta.pivothigh(pivotLen, pivotLen)
float pivotLo = ta.pivotlow(pivotLen, pivotLen)
int   pivotBar = bar_index - pivotLen
float bodyHi = math.max(open[pivotLen], close[pivotLen])
float bodyLo = math.min(open[pivotLen], close[pivotLen])
float anchorHi = useBody ? bodyHi : pivotHi
float anchorLo = useBody ? bodyLo : pivotLo

bool newRes = barstate.isconfirmed and not na(pivotHi) and not na(atrRaw)
bool newSup = barstate.isconfirmed and not na(pivotLo) and not na(atrRaw)

// -----------------------------------------------------------------------------
// 3. STORAGE (parallel arrays — one entry per live zone)
// -----------------------------------------------------------------------------
var array<box>   zBox    = array.new_box()
var array<line>  zLine   = array.new_line()
var array<label> zLabel  = array.new_label()
var array<float> zTop    = array.new_float()
var array<float> zBot    = array.new_float()
var array<int>   zStart  = array.new_int()
var array<bool>  zIsRes  = array.new_bool()
var array<bool>  zBroken = array.new_bool()

bool tapRes = false
bool tapSup = false
bool justBrokeRes = false
bool justBrokeSup = false

// helper: distance from the opposite-side zones (keeps the chart from stacking)
f_gapOk(bool isRes, float top, float bot) =>
    bool ok = true
    if array.size(zTop) > 0 and minGapMode != "Off"
        for i = 0 to array.size(zTop) - 1
            if array.get(zIsRes, i) != isRes
                float a = array.get(zTop, i)
                float b = array.get(zBot, i)
                float gap = isRes ? math.max(b - top, bot - a) : math.max(a - bot, top - b)
                float need = minGapMode == "ATR" ? minGapAtr * atrV : close * minGapPct / 100.0
                if gap < need
                    ok := false
    ok

// -----------------------------------------------------------------------------
// 4. CREATE ZONES
// -----------------------------------------------------------------------------
if newRes and f_gapOk(true, anchorHi, anchorHi - depth)
    float top = anchorHi
    float bot = anchorHi - depth
    box b = box.new(pivotBar, top, bar_index + extendBars, bot, xloc=xloc.bar_index, bgcolor=fillRes, border_color=bordRes, border_width=1, text=showLabels ? "R " + str.tostring(top, format.mintick) + " – " + str.tostring(bot, format.mintick) : "", text_size=size.tiny, text_color=txtCol, text_halign=text.align_right, text_valign=text.align_center)
    line l = na
    if showLevel
        l := line.new(pivotBar, bot, bar_index + extendBars, bot, xloc=xloc.bar_index, color=bordRes, style=line.style_dotted, width=1)
    label lb = na
    if showLabels
        lb := label.new(bar_index + extendBars, bot, str.tostring(bot, format.mintick) + " – " + str.tostring(top, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=txtCol, size=size.tiny)
    array.push(zBox, b)
    array.push(zLine, l)
    array.push(zLabel, lb)
    array.push(zTop, top)
    array.push(zBot, bot)
    array.push(zStart, pivotBar)
    array.push(zIsRes, true)
    array.push(zBroken, false)
    if showTopBot
        label.new(pivotBar, top + 0.4 * atrV, "TOP", style=label.style_label_down, color=color.new(color.red, 60), textcolor=color.white, size=size.tiny)

if newSup and f_gapOk(false, anchorLo + depth, anchorLo)
    float top = anchorLo + depth
    float bot = anchorLo
    box b2 = box.new(pivotBar, top, bar_index + extendBars, bot, xloc=xloc.bar_index, bgcolor=fillSup, border_color=bordSup, border_width=1, text=showLabels ? "S " + str.tostring(top, format.mintick) + " – " + str.tostring(bot, format.mintick) : "", text_size=size.tiny, text_color=txtCol, text_halign=text.align_right, text_valign=text.align_center)
    line l2 = na
    if showLevel
        l2 := line.new(pivotBar, top, bar_index + extendBars, top, xloc=xloc.bar_index, color=bordSup, style=line.style_dotted, width=1)
    label lb2 = na
    if showLabels
        lb2 := label.new(bar_index + extendBars, top, str.tostring(bot, format.mintick) + " – " + str.tostring(top, format.mintick), xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=txtCol, size=size.tiny)
    array.push(zBox, b2)
    array.push(zLine, l2)
    array.push(zLabel, lb2)
    array.push(zTop, top)
    array.push(zBot, bot)
    array.push(zStart, pivotBar)
    array.push(zIsRes, false)
    array.push(zBroken, false)
    if showTopBot
        label.new(pivotBar, pivotLo - 0.4 * atrV, "BOTTOM", style=label.style_label_up, color=color.new(color.green, 60), textcolor=color.white, size=size.tiny)

// -----------------------------------------------------------------------------
// 5. EXTEND / MITIGATE / RECYCLE
// -----------------------------------------------------------------------------
if array.size(zBox) > 0
    for i = array.size(zBox) - 1 to 0
        bool  isRes = array.get(zIsRes, i)
        bool  broken = array.get(zBroken, i)
        float top  = array.get(zTop, i)
        float bot  = array.get(zBot, i)
        box   b    = array.get(zBox, i)
        line  l    = array.get(zLine, i)
        label lb   = array.get(zLabel, i)
        bool tapped = isRes ? (high >= bot and low <= top) : (low <= top and high >= bot)
        if tapped and not broken
            if isRes
                tapRes := true
            else
                tapSup := true
            if showTouchHint and barstate.isconfirmed
                label.new(bar_index, isRes ? top : bot, "●", style=isRes ? label.style_label_down : label.style_label_up, color=color.new(color.black, 100), textcolor=isRes ? color.new(color.gray, 0) : color.new(color.gray, 0), size=size.tiny)
        if barstate.isconfirmed and not broken
            bool broke = isRes ? close > top + brkBuf : close < bot - brkBuf
            if broke
                array.set(zBroken, i, true)
                box.set_right(b, bar_index)
                if not na(l)
                    line.set_x2(l, bar_index)
                if not na(lb)
                    label.set_x(lb, bar_index)
                if isRes
                    justBrokeRes := true
                else
                    justBrokeSup := true
                if fadeBroken
                    box.set_bgcolor(b, color.new(color.gray, 94))
                    box.set_border_color(b, color.new(color.gray, 75))
                    if not na(l)
                        line.set_color(l, color.new(color.gray, 80))
            else
                box.set_right(b, bar_index + extendBars)
                if not na(l)
                    line.set_x2(l, bar_index + extendBars)
                if not na(lb)
                    label.set_x(lb, bar_index + extendBars)
    // remove faint / broken zones when over budget, oldest first
    while array.size(zBox) > maxZones
        box.delete(array.shift(zBox))
        line lrm = array.shift(zLine)
        label lbrm = array.shift(zLabel)
        if not na(lrm)
            line.delete(lrm)
        if not na(lbrm)
            label.delete(lbrm)
        array.shift(zTop)
        array.shift(zBot)
        array.shift(zStart)
        array.shift(zIsRes)
        array.shift(zBroken)

// remove broken zones immediately if requested
if removeBroken and array.size(zBox) > 0
    for i = array.size(zBox) - 1 to 0
        if array.get(zBroken, i)
            box bd = array.remove(zBox, i)
            line ld = array.get(zLine, i)
            label lbd = array.get(zLabel, i)
            array.remove(zLine, i)
            array.remove(zLabel, i)
            array.remove(zTop, i)
            array.remove(zBot, i)
            array.remove(zStart, i)
            array.remove(zIsRes, i)
            array.remove(zBroken, i)
            box.delete(bd)
            if not na(ld)
                line.delete(ld)
            if not na(lbd)
                label.delete(lbd)

// -----------------------------------------------------------------------------
// 6. HUD — nearest live zones
// -----------------------------------------------------------------------------
var table hud = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 82), border_width=1, border_color=color.new(color.gray, 70), frame_width=1, frame_color=color.new(color.gray, 55))
float nearRes = na
float nearSup = na
if array.size(zTop) > 0
    for i = 0 to array.size(zTop) - 1
        if not array.get(zBroken, i)
            if array.get(zIsRes, i)
                float cand = array.get(zBot, i)
                if na(nearRes) or cand < nearRes
                    nearRes := cand
            else
                float cand2 = array.get(zTop, i)
                if na(nearSup) or cand2 > nearSup
                    nearSup := cand2
if barstate.islast
    table.cell(hud, 0, 0, "🐘 ELEPHANT ZONES", text_color=color.new(color.yellow, 0), text_size=size.small)
    table.cell(hud, 1, 0, str.tostring(array.size(zBox)) + " live", text_color=color.new(color.silver, 0), text_size=size.small)
    table.cell(hud, 0, 1, "Nearest resistance", text_color=color.new(color.silver, 0), text_size=size.tiny)
    table.cell(hud, 1, 1, na(nearRes) ? "—" : str.tostring(nearRes, format.mintick) + " (" + str.tostring((nearRes - close) / atrV, "#.0") + " ATR)", text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(hud, 0, 2, "Nearest support", text_color=color.new(color.silver, 0), text_size=size.tiny)
    table.cell(hud, 1, 2, na(nearSup) ? "—" : str.tostring(nearSup, format.mintick) + " (" + str.tostring((close - nearSup) / atrV, "#.0") + " ATR)", text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(hud, 0, 3, "Zone depth", text_color=color.new(color.silver, 0), text_size=size.tiny)
    table.cell(hud, 1, 3, str.tostring(depth, format.mintick) + " (" + str.tostring(zoneAtr, "#.00") + " ATR)", text_color=color.new(color.white, 0), text_size=size.tiny)
    table.cell(hud, 0, 4, "Pivot strength", text_color=color.new(color.silver, 0), text_size=size.tiny)
    table.cell(hud, 1, 4, str.tostring(pivotLen) + " / " + str.tostring(pivotLen), text_color=color.new(color.white, 0), text_size=size.tiny)

// -----------------------------------------------------------------------------
// 7. ALERTS
// -----------------------------------------------------------------------------
alertcondition(newRes, "Elephant new RESISTANCE zone", "🐘 New resistance zone on {{ticker}} {{interval}} — a top has been confirmed.")
alertcondition(newSup, "Elephant new SUPPORT zone", "🐘 New support zone on {{ticker}} {{interval}} — a bottom has been confirmed.")
alertcondition(tapRes and barstate.isconfirmed, "Elephant resistance tapped", "🐘 Price is tapping a resistance zone on {{ticker}} {{interval}} at {{close}}.")
alertcondition(tapSup and barstate.isconfirmed, "Elephant support tapped", "🐘 Price is tapping a support zone on {{ticker}} {{interval}} at {{close}}.")
alertcondition(justBrokeRes and barstate.isconfirmed, "Elephant resistance BROKEN", "🐘 Resistance zone broken on {{ticker}} {{interval}} at {{close}} — tops are being taken out.")
alertcondition(justBrokeSup and barstate.isconfirmed, "Elephant support BROKEN", "🐘 Support zone broken on {{ticker}} {{interval}} at {{close}} — bottoms are being taken out.")

if tapRes and barstate.isconfirmed
    alert("🐘 Resistance tapped | " + syminfo.ticker + " " + timeframe.period + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if tapSup and barstate.isconfirmed
    alert("🐘 Support tapped | " + syminfo.ticker + " " + timeframe.period + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
