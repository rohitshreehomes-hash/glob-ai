# ---------- BharatTrade configuration ----------
# Copy to .env and adjust. All values optional — sane defaults apply.

# SQLite data directory (paper account, holdings, orders, watchlist)
DATA_DIR=./data

# Starting virtual capital (INR) for a fresh / reset paper account
STARTING_CAPITAL=1000000

# Flat brokerage charged per executed paper order (INR)
BROKERAGE_PER_ORDER=20

# Quote poll interval for the UI (ms)
NEXT_PUBLIC_POLL_MS=15000

# Display name in the navbar
NEXT_PUBLIC_APP_NAME=BharatTrade

# ---------- Future: real broker integration (Zerodha Kite Connect) ----------
# The order engine (src/lib/broker.ts) is interface-ready. When you go live:
# ZERODHA_API_KEY=
# ZERODHA_API_SECRET=
# ZERODHA_ACCESS_TOKEN=
