//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  SBE ALL-IN-ONE  —  Activity Map + Swing + Side Base + BUY / SALE / EXIT
//  ───────────────────────────────────────────────────────────────────────────
//  SAB KUCH EK SCRIPT ME:
//
//  1) ACTIVITY MAP (volume profile)
//       POC  = sabse zyada volume wali price  ("log yahan trade kar rahe hain")
//       VAH / VAL = value area (70% volume)   -> crowd ka area
//       HVN  = high volume shelves
//       Right side histogram + volume spike dots
//
//  2) SWING (structure)
//       Higher-low / lower-high pivots -> swing BUY / SALE
//       Zig-zag lines (optional)
//
//  3) SIDE BASE
//       Tight range detect -> SIDE (wait) + box
//       Breakout par BUY / SALE confirm
//
//  4) CONFIRMATION ENGINE
//       VAL reject / VAH reject / POC reclaim / POC loss /
//       base breakout / HL-LH swing  +  4-point score  +  EMA gate
//
//  5) EXIT
//       POC loss / target / swing flip / opposite swing / ATR trail
//
//  • Har signal bar CLOSE par confirm (barstate.isconfirmed) -> repaint nahi.
//  • Ek time par ek hi position (no pyramiding).
//  • Dashboard + 4 alerts (BUY / SALE / EXIT / SIDE).
//  • Tested: see pine/TEST_REPORT.md (static check + reference backtest).
// ═══════════════════════════════════════════════════════════════════════════════
indicator("SBE ALL-IN-ONE — Activity + Swing + Side Base", "SBE", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ────────────────────────────── ① SIGNAL MODE ────────────────────────────────
string gMode  = "① Signals"
bool   sigAct = input.bool(true, "Activity signals (POC / VAL / VAH)", group = gMode)
bool   sigSw  = input.bool(true, "Swing signals (HL / LH pivots)", group = gMode)
bool   sigBase = input.bool(true, "Side base breakout signals", group = gMode)
bool   allowLong  = input.bool(true, "Allow BUY", group = gMode, inline = "a")
bool   allowShort = input.bool(true, "Allow SALE", group = gMode, inline = "a")
bool   allowReverse = input.bool(false, "Reverse on flip", group = gMode)

// ─────────────────────────── ② ACTIVITY / PROFILE ────────────────────────────
string gProf    = "② Activity map (volume profile)"
bool   profOn   = input.bool(true, "Show profile", group = gProf)
string anchorIn = input.string("Day", "Anchor", options = ["Day", "Week", "Month"], group = gProf, tooltip = "Profile reset period. Intraday chart par Day best hai.")
int    nRows    = input.int(24, "Rows (bins)", minval = 8, maxval = 60, group = gProf)
float  vaPct    = input.float(70.0, "Value area %", minval = 30, maxval = 95, step = 5, group = gProf)
float  padPct   = input.float(10.0, "Range padding %", minval = 0, maxval = 50, step = 5, group = gProf)
int    profW    = input.int(30, "Histogram width (bars)", minval = 5, maxval = 60, group = gProf)
float  hvnRatio = input.float(65.0, "HVN threshold (% of POC)", minval = 20, maxval = 95, step = 5, group = gProf)
bool   histOn   = input.bool(true, "Histogram", inline = "p1", group = gProf)
bool   linesOn  = input.bool(true, "Lines", inline = "p1", group = gProf)
bool   bandOn   = input.bool(true, "Band", inline = "p1", group = gProf)
bool   spikeOn  = input.bool(true, "Volume spikes", inline = "p1", group = gProf)
color  cPoc     = input.color(#ffb74d, "POC", inline = "p2", group = gProf)
color  cHvn     = input.color(#42a5f5, "HVN", inline = "p2", group = gProf)

string anchorTf = anchorIn == "Day" ? "D" : anchorIn == "Week" ? "W" : "M"

// ─────────────────────────────── ③ SWING ─────────────────────────────────────
string gSwing = "③ Swing"
int    pivLen = input.int(5, "Pivot length", minval = 2, maxval = 50, group = gSwing, tooltip = "Bada = major swings, chhota = zyada signals.")
bool   zigOn  = input.bool(true, "Zig-zag lines", group = gSwing)
color  cZig   = input.color(#ffb74d, "Zig-zag", group = gSwing)

// ─────────────────────────── ④ SIDE BASE ─────────────────────────────────────
string gBase = "④ Side base"
bool   baseOn    = input.bool(true, "Detect side base", group = gBase)
int    baseLen   = input.int(12, "Lookback (bars)", minval = 5, maxval = 100, group = gBase, tooltip = "Kitne bars ka tight range base mana jaye (12 bars = 1 ghanta on 5m).")
int    baseLen2  = input.int(50, "Compression vs (bars)", minval = 20, maxval = 200, group = gBase, tooltip = "Chhoti range ko is badi range se compare karte hain.")
float  compress  = input.float(45.0, "Compression %", minval = 10, maxval = 90, step = 5, group = gBase, tooltip = "Chhota range <= itne % of badi range -> side base. Zyada base chahiye to 55, kam chahiye to 35.")
float  baseMult  = input.float(3.5, "ATR cap (× ATR)", minval = 0.5, step = 0.5, group = gBase, tooltip = "Safety cap: base itne ATR se zyada mota nahi hona chahiye.")
bool   showBaseBox = input.bool(true, "Show base box", group = gBase)
int    baseExpiry = input.int(30, "Breakout valid (bars)", minval = 1, maxval = 200, group = gBase)

// ───────────────────────── ⑤ CONFIRMATION ────────────────────────────────────
string gConf   = "⑤ Confirmation"
int    minConf = input.int(2, "Min score (1-4)", minval = 1, maxval = 4, group = gConf, tooltip = "2 = balanced, 3 = sirf strong setups, 1 = loose.")
float  volMult = input.float(1.3, "Volume spike ×", minval = 0.5, step = 0.1, group = gConf)
int    volLen  = input.int(20, "Volume average", minval = 5, group = gConf)
bool   emaOn   = input.bool(true, "EMA gate", inline = "e1", group = gConf)
int    emaLen  = input.int(21, "EMA length", minval = 2, inline = "e1", group = gConf)

// ────────────────────────────── ⑥ EXITS ──────────────────────────────────────
string gEx     = "⑥ Exits"
bool   exitPoc     = input.bool(true, "Exit on POC loss", group = gEx)
bool   exitTarget  = input.bool(true, "Exit at target", group = gEx)
bool   exitFlip    = input.bool(true, "Exit on swing flip", group = gEx)
bool   exitOppSwing = input.bool(false, "Exit on opposite pivot", group = gEx)
bool   exitTrail   = input.bool(true, "ATR trailing stop", group = gEx)
int    atrLen      = input.int(14, "ATR length", minval = 1, group = gEx)
float  trailMult   = input.float(2.0, "ATR ×", minval = 0.1, step = 0.1, group = gEx)

// ───────────────────────────── ⑦ SESSION ─────────────────────────────────────
string gSess   = "⑦ Session"
bool   useSess = input.bool(false, "Signal only inside session", group = gSess)
string sessStr = input.session("0915-1530", "Session", group = gSess)
string sessTz  = input.string("Asia/Kolkata", "Timezone", group = gSess)

// ────────────────────────────── ⑧ STYLE ──────────────────────────────────────
string gStyle    = "⑧ Style"
color  cBuy      = input.color(#26a69a, "BUY",  inline = "s1", group = gStyle)
color  cSell     = input.color(#ef5350, "SALE", inline = "s1", group = gStyle)
color  cExit     = input.color(#ffa726, "EXIT", inline = "s1", group = gStyle)
color  cSide     = input.color(#787b86, "SIDE", inline = "s2", group = gStyle)
string lblSizeIn = input.string("normal", "Label size", options = ["tiny", "small", "normal", "large"], inline = "s3", group = gStyle)
bool   showTable = input.bool(true, "Dashboard", inline = "s3", group = gStyle)
bool   showReason = input.bool(true, "Reason in label", group = gStyle)
bool   showShapes = input.bool(true, "Arrows on chart", group = gStyle)

string lblSz = switch lblSizeIn
    "tiny"  => size.tiny
    "small" => size.small
    "large" => size.large
    =>        size.normal

f_label(_x, _y, _txt, _col, _atLow) =>
    label.new(_x, _y, _txt, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(_col, 10), style = _atLow ? label.style_label_up : label.style_label_down, textcolor = color.white, size = lblSz)

f_txt(_base, _px) =>
    _base + " " + str.tostring(nz(_px), format.mintick)

// ───────────────────────────── CORE SERIES ───────────────────────────────────
float atr    = ta.atr(atrLen)
float atrU   = nz(atr, (high - low) * 2)
float emaF   = ta.ema(close, emaLen)
float volAvg = ta.sma(volume, volLen)
bool  volSpike = nz(volume) > volAvg * volMult
bool  inSes  = not useSess or not na(time(timeframe.period, sessStr, sessTz))
float hiN    = ta.highest(high, baseLen)
float loN    = ta.lowest(low, baseLen)
float hiN2   = ta.highest(high, baseLen2)
float loN2   = ta.lowest(low, baseLen2)
bool  barDone = barstate.isconfirmed

float ph    = ta.pivothigh(high, pivLen, pivLen)
float pl    = ta.pivotlow(low, pivLen, pivLen)
bool  newPH = not na(ph)
bool  newPL = not na(pl)

// ─────────────────────── VOLUME PROFILE (session anchored) ───────────────────
var array<float> bins = array.new_float(nRows, 0.0)
var array<float> bHi  = array.new_float()
var array<float> bLo  = array.new_float()
var array<float> bVol = array.new_float()
var float rHi = na
var float rLo = na
var int   sessStart = na

bool newSess = timeframe.change(anchorTf) or bar_index == 0

if newSess
    array.fill(bins, 0.0)
    array.clear(bHi)
    array.clear(bLo)
    array.clear(bVol)
    rHi := high
    rLo := low
    sessStart := bar_index

float rngMin = atrU * 0.5
float rng0   = math.max(rHi - rLo, rngMin)
bool  expand = high > rHi + rng0 * padPct / 100.0 or low < rLo - rng0 * padPct / 100.0

if expand
    rHi := math.max(rHi, high)
    rLo := math.min(rLo, low)

array.push(bHi, high)
array.push(bLo, low)
array.push(bVol, nz(volume, 1.0))

float rng    = math.max(rHi - rLo, rngMin)
float pLo    = rLo - rng * padPct / 100.0
float pHi    = rHi + rng * padPct / 100.0
float pStep  = (pHi - pLo) / nRows
bool  canBin = pStep > 0
bool  rebuild = newSess or expand

if canBin
    if rebuild
        array.fill(bins, 0.0)
        for i = 0 to array.size(bHi) - 1
            int   i1 = math.max(0, math.min(nRows - 1, int((array.get(bLo, i) - pLo) / pStep)))
            int   i2 = math.max(0, math.min(nRows - 1, int((array.get(bHi, i) - pLo) / pStep)))
            float vI = array.get(bVol, i) / (i2 - i1 + 1)
            for k = i1 to i2
                array.set(bins, k, array.get(bins, k) + vI)
    else
        int   b1 = math.max(0, math.min(nRows - 1, int((low  - pLo) / pStep)))
        int   b2 = math.max(0, math.min(nRows - 1, int((high - pLo) / pStep)))
        float vB = nz(volume, 1.0) / (b2 - b1 + 1)
        for k = b1 to b2
            array.set(bins, k, array.get(bins, k) + vB)

// POC = sabse zyada volume wali row
float maxV = 0.0
int   pocB = 0
if canBin
    for k = 0 to nRows - 1
        float vb = array.get(bins, k)
        if vb > maxV
            maxV := vb
            pocB := k

// Value area: POC se expand karke 70% volume cover karo
float totalV  = array.sum(bins)
float targetV = totalV * vaPct / 100.0
float accV    = maxV
int   upI     = pocB
int   dnI     = pocB

for k = 1 to nRows
    if accV < targetV
        bool  canU = upI < nRows - 1
        bool  canD = dnI > 0
        float vU   = array.get(bins, math.min(upI + 1, nRows - 1))
        float vD   = array.get(bins, math.max(dnI - 1, 0))
        if canU and (vU >= vD or not canD)
            upI  += 1
            accV += vU
        else if canD
            dnI  -= 1
            accV += vD

float pocPx = canBin ? pLo + (pocB + 0.5) * pStep : na
float vahPx = canBin ? pLo + (upI + 1) * pStep   : na
float valPx = canBin ? pLo + dnI * pStep         : na
bool  okProf = not na(pocPx) and not na(vahPx) and not na(valPx)
bool  insideVA = okProf and close <= nz(vahPx, close) and close >= nz(valPx, close)

// ───────────────────────── VALUE AREA VISUALS ────────────────────────────────
var box  vaBox = na
var line lnPoc = na
var line lnVah = na
var line lnVal = na

if profOn and bandOn and okProf and not na(sessStart)
    if na(vaBox)
        vaBox := box.new(sessStart, vahPx, bar_index + 2, valPx, border_color = color.new(color.gray, 100), bgcolor = color.new(cSide, 94))
    box.set_left(vaBox, sessStart)
    box.set_top(vaBox, vahPx)
    box.set_bottom(vaBox, valPx)
    box.set_right(vaBox, bar_index + 2)

if profOn and linesOn and okProf and not na(sessStart)
    if na(lnPoc)
        lnPoc := line.new(sessStart, pocPx, bar_index + 2, pocPx, color = cPoc, width = 2)
        lnVah := line.new(sessStart, vahPx, bar_index + 2, vahPx, color = color.new(cHvn, 30), width = 1, style = line.style_dashed)
        lnVal := line.new(sessStart, valPx, bar_index + 2, valPx, color = color.new(cHvn, 30), width = 1, style = line.style_dashed)
    line.set_xy1(lnPoc, sessStart, pocPx)
    line.set_xy2(lnPoc, bar_index + 2, pocPx)
    line.set_xy1(lnVah, sessStart, vahPx)
    line.set_xy2(lnVah, bar_index + 2, vahPx)
    line.set_xy1(lnVal, sessStart, valPx)
    line.set_xy2(lnVal, bar_index + 2, valPx)

// ─────────────────── HISTOGRAM (right side, last bar only) ───────────────────
var array<box> hBox = array.new<box>()

if profOn and histOn and barstate.islast
    if array.size(hBox) != nRows
        if array.size(hBox) > 0
            for j = 0 to array.size(hBox) - 1
                box.delete(array.get(hBox, j))
            array.clear(hBox)
        for j = 0 to nRows - 1
            array.push(hBox, box.new(bar_index + 3, 0.0, bar_index + 4, 0.0, border_color = color.new(color.gray, 100), bgcolor = color.new(cHvn, 70)))
    if canBin and maxV > 0
        for j = 0 to nRows - 1
            float hv  = array.get(bins, j)
            box   bb  = array.get(hBox, j)
            int   ww  = math.max(1, int(math.round(profW * hv / maxV)))
            bool  isP = j == pocB
            bool  isU = j == upI
            bool  isD = j == dnI
            box.set_top(bb, pLo + (j + 1) * pStep)
            box.set_bottom(bb, pLo + j * pStep)
            box.set_left(bb, bar_index + 3)
            box.set_right(bb, bar_index + 3 + ww)
            box.set_bgcolor(bb, hv <= 0 ? color.new(cHvn, 100) : isP ? color.new(cPoc, 10) : hv >= maxV * hvnRatio / 100.0 ? color.new(cHvn, 35) : color.new(cHvn, 72))
            box.set_text(bb, isP ? "POC" : isU ? "VAH" : isD ? "VAL" : "")
            box.set_text_color(bb, color.white)
            box.set_text_size(bb, size.tiny)
            box.set_text_halign(bb, text.align_center)
            box.set_text_valign(bb, text.align_center)

// ────────────────────────── SWING / STRUCTURE ────────────────────────────────
var float lastSH = na
var float lastSL = na
var float prevSH = na
var float prevSL = na

if newPH
    prevSH := lastSH
    lastSH := ph
if newPL
    prevSL := lastSL
    lastSL := pl

var bool trendUp = true
if newPL and (na(prevSL) or pl > prevSL)
    trendUp := true
if newPH and (na(prevSH) or ph < prevSH)
    trendUp := false

var int zzX = na
var float zzY = na

if zigOn and (newPH or newPL)
    float zzP = newPH ? ph : pl
    int   zzB = bar_index - pivLen
    if not na(zzX)
        line.new(zzX, zzY, zzB, zzP, xloc = xloc.bar_index, color = cZig, width = 1)
    zzX := zzB
    zzY := zzP

// ───────────────────────────── SIDE BASE ─────────────────────────────────────
float bigRange = nz(hiN2 - loN2, hiN - loN)
float baseCap  = math.min(baseMult * atrU, compress / 100.0 * bigRange)
bool tightBase = baseOn and (hiN - loN) <= baseCap

var box   baseBox   = na
var float baseTop   = na
var float baseBot   = na
var int   baseCnt   = 0
var bool  baseArmed = false
var int   baseEnd   = na

if tightBase
    baseCnt += 1
    if baseCnt == baseLen
        baseTop   := hiN
        baseBot   := loN
        baseArmed := false
        if showBaseBox
            baseBox := box.new(bar_index - baseLen + 1, baseTop, bar_index, baseBot, border_color = color.new(cSide, 20), border_width = 1, bgcolor = color.new(cSide, 88), text = "SIDE BASE", text_size = size.small, text_color = cSide, text_halign = text.align_center, text_valign = text.align_center)
    if baseCnt > baseLen
        baseTop := math.max(baseTop, high)
        baseBot := math.min(baseBot, low)
        if not na(baseBox)
            box.set_top(baseBox, baseTop)
            box.set_bottom(baseBox, baseBot)
            box.set_right(baseBox, bar_index)
else
    if baseCnt >= baseLen
        baseArmed := true
        baseEnd   := bar_index - 1
    baseCnt := 0
    baseBox := na

bool baseUp      = baseArmed and not na(baseTop) and close > baseTop
bool baseDn      = baseArmed and not na(baseBot) and close < baseBot
bool baseExpired = baseArmed and not na(baseEnd) and (bar_index - baseEnd) > baseExpiry

if baseUp or baseDn or baseExpired
    baseArmed := false

// ───────────────────────────── TRIGGERS ──────────────────────────────────────
bool trigValReject  = okProf and low  <= nz(valPx, low)  and close > nz(valPx, close) and close > open
bool trigVahReject  = okProf and high >= nz(vahPx, high) and close < nz(vahPx, close) and close < open
bool xPocUp = ta.crossover(close, pocPx) == true
bool xPocDn = ta.crossunder(close, pocPx) == true
bool trigPocReclaim = okProf and xPocUp
bool trigPocLoss    = okProf and xPocDn

bool actUp = sigAct and (trigValReject or trigPocReclaim)
bool actDn = sigAct and (trigVahReject or trigPocLoss)
bool swUp  = sigSw and newPL and trendUp
bool swDn  = sigSw and newPH and not trendUp
bool bsUp  = sigBase and baseOn and baseUp
bool bsDn  = sigBase and baseOn and baseDn

bool trigUp = actUp or swUp or bsUp
bool trigDn = actDn or swDn or bsDn

// ───────────────────────────── SCORE (0-4) ───────────────────────────────────
int confUp = (close > nz(pocPx, close) ? 1 : 0) + (volSpike ? 1 : 0) + (trendUp ? 1 : 0) + (close > nz(valPx, close) ? 1 : 0)
int confDn = (close < nz(pocPx, close) ? 1 : 0) + (volSpike ? 1 : 0) + (not trendUp ? 1 : 0) + (close < nz(vahPx, close) ? 1 : 0)

bool emaOkUp = not emaOn or close > emaF
bool emaOkDn = not emaOn or close < emaF

// ───────────────────────────── SIGNAL STATE ──────────────────────────────────
var int   state   = 0
var float entryPx = na
var float stopPx  = na
var float tpPx    = na
var bool  eAbovePoc = false
var bool  eBelowPoc = false
var float realized  = 0.0
var int   tradesN   = 0
var int   winsN     = 0
var int   lossN     = 0
var float grossWin  = 0.0
var float grossLoss = 0.0

bool buySig  = false
bool sellSig = false
bool exitSig = false
bool didExit = false
string buyWhy  = ""
string sellWhy = ""

// ──────────────────────────────── EXITS ──────────────────────────────────────
bool trailLongHit  = exitTrail and state == 1 and not na(stopPx) and low  <= nz(stopPx, low)
bool trailShortHit = exitTrail and state == -1 and not na(stopPx) and high >= nz(stopPx, high)
bool pocLongExit   = exitPoc and state == 1 and eAbovePoc and trigPocLoss
bool pocShortExit  = exitPoc and state == -1 and eBelowPoc and trigPocReclaim
bool tgtLongExit   = exitTarget and state == 1 and not na(tpPx) and close >= nz(tpPx, close + 1)
bool tgtShortExit  = exitTarget and state == -1 and not na(tpPx) and close <= nz(tpPx, close - 1)
bool flipLongExit  = exitFlip and state == 1 and newPH and not trendUp
bool flipShortExit = exitFlip and state == -1 and newPL and trendUp
bool oppLongExit   = exitOppSwing and state == 1 and newPH
bool oppShortExit  = exitOppSwing and state == -1 and newPL

bool exitLong  = state ==  1 and (trailLongHit  or pocLongExit  or tgtLongExit  or flipLongExit  or oppLongExit)
bool exitShort = state == -1 and (trailShortHit or pocShortExit or tgtShortExit or flipShortExit or oppShortExit)

if exitLong and barDone
    float pxL = trailLongHit ? nz(stopPx, close) : close
    float pnlL = pxL - entryPx
    f_label(bar_index, math.max(high, pxL), f_txt("EXIT", pxL), cExit, false)
    realized += pnlL
    tradesN  += 1
    if pnlL > 0
        winsN    += 1
        grossWin += pnlL
    else
        lossN    += 1
        grossLoss += -pnlL
    state := 0
    entryPx := na
    stopPx  := na
    tpPx    := na
    exitSig := true
    didExit := true

if exitShort and barDone
    float pxS = trailShortHit ? nz(stopPx, close) : close
    float pnlS = entryPx - pxS
    f_label(bar_index, math.min(low, pxS), f_txt("EXIT", pxS), cExit, true)
    realized += pnlS
    tradesN  += 1
    if pnlS > 0
        winsN    += 1
        grossWin += pnlS
    else
        lossN    += 1
        grossLoss += -pnlS
    state := 0
    entryPx := na
    stopPx  := na
    tpPx    := na
    exitSig := true
    didExit := true

// ──────────────────────────────── ENTRIES ────────────────────────────────────
bool canEnter = state == 0 and (allowReverse or not didExit) and barDone and inSes and okProf

if canEnter and allowLong and trigUp and confUp >= minConf and emaOkUp
    state   := 1
    entryPx := close
    float slL = bsUp and not na(baseBot) ? baseBot : nz(valPx, close)
    stopPx  := math.max(slL, close - atrU * 3)
    tpPx    := close > nz(pocPx, close) ? (close < nz(vahPx, close) ? vahPx : close + (nz(vahPx, close) - nz(valPx, close)) * 0.5) : pocPx
    eAbovePoc := close > nz(pocPx, close)
    eBelowPoc := false
    buyWhy := bsUp ? "base BO" : trigPocReclaim ? "POC reclaim" : trigValReject ? "VAL reject" : "HL swing"
    buySig := true
    f_label(bar_index, low, showReason ? "BUY ✓\n" + buyWhy : "BUY ✓", cBuy, true)

if canEnter and allowShort and trigDn and confDn >= minConf and emaOkDn
    state   := -1
    entryPx := close
    float slS = bsDn and not na(baseTop) ? baseTop : nz(vahPx, close)
    stopPx  := math.min(slS, close + atrU * 3)
    tpPx    := close < nz(pocPx, close) ? (close > nz(valPx, close) ? valPx : close - (nz(vahPx, close) - nz(valPx, close)) * 0.5) : pocPx
    eAbovePoc := false
    eBelowPoc := close < nz(pocPx, close)
    sellWhy := bsDn ? "base BO" : trigPocLoss ? "POC loss" : trigVahReject ? "VAH reject" : "LH swing"
    sellSig := true
    f_label(bar_index, high, showReason ? "SALE ✓\n" + sellWhy : "SALE ✓", cSell, false)

// ATR trailing
if state == 1 and exitTrail
    stopPx := na(stopPx) ? low - trailMult * atrU : math.max(stopPx, low - trailMult * atrU)
if state == -1 and exitTrail
    stopPx := na(stopPx) ? high + trailMult * atrU : math.min(stopPx, high + trailMult * atrU)

// ───────────────────────────── SIDE MODE ─────────────────────────────────────
bool sideNow = baseOn and tightBase and insideVA and state == 0
var bool sidePrev = false
bool sideStart = sideNow and not sidePrev
sidePrev := sideNow

var int lastSideBar = na
bool sideCool = na(lastSideBar) or (bar_index - lastSideBar) >= 10

if sideStart and barDone and sideCool
    f_label(bar_index, high, "SIDE", cSide, false)
    lastSideBar := bar_index

// ───────────────────────────────── PLOTS ────────────────────────────────────
plot(emaOn ? emaF : na, "EMA", color.new(#ab47bc, 30), 1)
plotshape(spikeOn and volSpike, "Volume spike", shape.circle, location.bottom, color.new(cHvn, 45), size = size.tiny)
plotshape(showShapes and buySig,  "BUY",  shape.triangleup,   location.belowbar, cBuy,  size = size.tiny)
plotshape(showShapes and sellSig, "SALE", shape.triangledown, location.abovebar, cSell, size = size.tiny)

// ─────────────────────────────── DASHBOARD ───────────────────────────────────
var table dash = table.new(position.top_right, 2, 13, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 60), border_color = color.new(color.gray, 85))

if showTable and barstate.islast
    color  mc  = color.new(#b2b5be, 0)
    color  hdr = color.new(#1e222d, 0)
    string dec = buySig ? "BUY CONFIRM ✓" : sellSig ? "SALE CONFIRM ✓" : state == 1 ? "LONG RUNNING" : state == -1 ? "SHORT RUNNING" : sideNow ? "SIDE — WAIT" : "NO TRADE — WAIT"
    color  dcol = buySig or state == 1 ? cBuy : sellSig or state == -1 ? cSell : cSide
    string posT = state == 1 ? "LONG" : state == -1 ? "SHORT" : "FLAT"
    string why  = buySig ? buyWhy : sellSig ? sellWhy : "—"
    string slt  = na(stopPx) ? "—" : str.tostring(nz(stopPx), format.mintick) + " / " + str.tostring(nz(tpPx), format.mintick)
    string modes = (sigAct ? "ACT " : "") + (sigSw ? "SWING " : "") + (sigBase ? "BASE" : "")
    float  pf    = grossLoss > 0 ? grossWin / grossLoss : grossWin > 0 ? 99.0 : 0.0
    string pnlTxt = str.tostring(realized, "#.##") + " pts · PF " + str.tostring(pf, "#.##")
    table.cell(dash, 0, 0, "SBE ALL-IN-ONE", text_color = color.white, text_size = size.small, bgcolor = hdr)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = mc, text_size = size.small, bgcolor = hdr)
    table.cell(dash, 0, 1, "Decision", text_color = mc, text_size = size.small)
    table.cell(dash, 1, 1, dec, text_color = color.white, text_size = size.small, bgcolor = dcol)
    table.cell(dash, 0, 2, "Trigger", text_color = mc, text_size = size.small)
    table.cell(dash, 1, 2, why, text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 3, "Position", text_color = mc, text_size = size.small)
    table.cell(dash, 1, 3, posT, text_color = state == 0 ? color.white : color.black, text_size = size.small, bgcolor = state == 0 ? color.new(cSide, 40) : state == 1 ? cBuy : cSell)
    table.cell(dash, 0, 4, "POC", text_color = mc, text_size = size.small)
    table.cell(dash, 1, 4, na(pocPx) ? "—" : str.tostring(nz(pocPx), format.mintick), text_color = cPoc, text_size = size.small)
    table.cell(dash, 0, 5, "VAH / VAL", text_color = mc, text_size = size.small)
    table.cell(dash, 1, 5, okProf ? str.tostring(nz(vahPx), format.mintick) + " / " + str.tostring(nz(valPx), format.mintick) : "—", text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 6, "Volume", text_color = mc, text_size = size.small)
    table.cell(dash, 1, 6, str.tostring(nz(volume / volAvg), "#.##") + "× avg" + (volSpike ? " ⚡" : ""), text_color = volSpike ? cBuy : mc, text_size = size.small)
    table.cell(dash, 0, 7, "Entry", text_color = mc, text_size = size.small)
    table.cell(dash, 1, 7, na(entryPx) ? "—" : str.tostring(nz(entryPx), format.mintick), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 8, "SL / Target", text_color = mc, text_size = size.small)
    table.cell(dash, 1, 8, slt, text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 9, "Score L / S", text_color = mc, text_size = size.small)
    table.cell(dash, 1, 9, str.tostring(confUp) + "/4 · " + str.tostring(confDn) + "/4", text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 10, "Trades W / L", text_color = mc, text_size = size.small)
    table.cell(dash, 1, 10, str.tostring(tradesN) + " · " + str.tostring(winsN) + " / " + str.tostring(lossN), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 11, "P&L (points)", text_color = mc, text_size = size.small)
    table.cell(dash, 1, 11, pnlTxt, text_color = realized >= 0 ? cBuy : cSell, text_size = size.small)
    table.cell(dash, 0, 12, "Active", text_color = mc, text_size = size.small)
    table.cell(dash, 1, 12, modes + " · " + anchorIn, text_color = color.white, text_size = size.small)

// ───────────────────────────────── ALERTS ───────────────────────────────────
alertcondition(buySig, title = "BUY CONFIRM", message = "BUY confirmed • {{ticker}} • {{interval}} • @ {{close}}")
alertcondition(sellSig, title = "SALE CONFIRM", message = "SALE confirmed • {{ticker}} • {{interval}} • @ {{close}}")
alertcondition(exitSig, title = "EXIT", message = "EXIT • {{ticker}} • {{interval}} • @ {{close}}")
alertcondition(sideStart, title = "SIDE — wait", message = "SIDE base — no trade • {{ticker}} • {{interval}}")

if buySig
    alert("BUY CONFIRM " + syminfo.ticker + " " + timeframe.period + " @ " + str.tostring(close, format.mintick) + " (" + buyWhy + ")", alert.freq_once_per_bar_close)
if sellSig
    alert("SALE CONFIRM " + syminfo.ticker + " " + timeframe.period + " @ " + str.tostring(close, format.mintick) + " (" + sellWhy + ")", alert.freq_once_per_bar_close)
if exitSig
    alert("EXIT " + syminfo.ticker + " " + timeframe.period + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
